PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>
JWT_SECRET=<random-long-secret>
JWT_EXPIRES_IN=12h
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=<seed-password>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset for local dev (Vite's proxy makes requests same-origin, so it
# doesn't matter) or when the frontend is served by this same process.
# Required when the frontend is deployed as its own static site, e.g.:
# CORS_ORIGIN=https://med-shop-web.onrender.com
CORS_ORIGIN=
